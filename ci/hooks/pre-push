#!/bin/sh
# SPDX-License-Identifier: MPL-2.0
# This Source Code Form is subject to the terms of the Mozilla Public License, v. 2.0. If a copy of the MPL was
# not distributed with this file, You can obtain one at https://mozilla.org/MPL/2.0/.
#
# Stops a push to main whose commit has not passed ci/local.py on this machine: a pass is
# recorded by the commit's tree (ci/local.py), so this looks it up rather than running the jobs
# again, and a commit reworded or signed again after its pass still has it. A push that changes
# Markdown alone needs none, but for the README and the site's pages under docs/ (not docs/dev/): CI does not run for
# one either
# (ci.yml's paths).
# Turn it on in a clone with: git config core.hooksPath ci/hooks
set -eu
zero=0000000000000000000000000000000000000000
passed=$(git rev-parse --git-common-dir)/ci-passed
status=0
# git hands the hook one line per ref: <local ref> <local sha> <remote ref> <remote sha>.
while read -r _ local_sha remote_ref remote_sha; do
  [ "$remote_ref" = refs/heads/main ] && [ "$local_sha" != "$zero" ] || continue
  if [ "$remote_sha" != "$zero" ] && git cat-file -e "$remote_sha^{commit}" 2> /dev/null &&
    [ -z "$(git diff --name-only "$remote_sha" "$local_sha" -- . ':(exclude,glob)**/*.md')" ] &&
    [ -z "$(git diff --name-only "$remote_sha" "$local_sha" -- README.md docs ':(exclude)docs/dev')" ]; then
    continue
  fi
  [ -f "$passed/$(git rev-parse "$local_sha^{tree}")" ] && continue
  short=$(git rev-parse --short "$local_sha")
  echo "pre-push: $short has not passed the local CI on this machine: ci/local.py $short" >&2
  status=1
done
exit $status
