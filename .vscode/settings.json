{
  // clangd does the C++ work; Microsoft's IntelliSense would draw its own (wrong) squiggles.
  "C_Cpp.intelliSenseEngine": "disabled",
  "clangd.arguments": [
    // compile_commands.json comes from: python3 tools/gen_compile_commands.py
    "--compile-commands-dir=${workspaceFolder}",
    // Lets clangd ask g++ for its standard-library paths (the commands say "c++").
    "--query-driver=/usr/bin/c++,/usr/bin/g++*,/usr/local/bin/g++*",
    "--background-index",
    "--header-insertion=never",
    "--completion-style=detailed"
  ],
  "files.associations": {
    "*.hpp": "cpp",
    "*.h": "cpp"
  },
  // clangd formats with .clang-format; CI checks with clang-format 23.1.3 (tools/format.sh).
  "[cpp]": {
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
    "editor.formatOnSave": true
  }
}