{
  // clangd does the C++ work; Microsoft's IntelliSense would draw its own (wrong) squiggles.
  "C_Cpp.intelliSenseEngine": "disabled",
  "clangd.arguments": [
    // compile_commands.json comes from: python3 tools/gen_compile_commands.py
    "--compile-commands-dir=${workspaceFolder}",
    // Lets clangd ask g++ for its standard-library paths (the commands say "c++").
    "--query-driver=/usr/bin/c++,/usr/bin/g++*,/usr/local/bin/g++*",
    "--background-index",
    "--header-insertion=never",
    "--completion-style=detailed"
  ],
  "files.associations": {
    "*.hpp": "cpp",
    "*.h": "cpp"
  },
  // A save formats with tools/clang-format, the version tools/format.sh pins, as CI checks: clangd's own
  // formatter would follow clangd's version instead. The extension expands ${workspaceRoot} only.
  "clang-format.executable": "${workspaceRoot}/tools/clang-format",
  "[cpp]": {
    "editor.defaultFormatter": "xaver.clang-format",
    "editor.formatOnSave": true
  }
}